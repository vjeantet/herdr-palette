{
  "schema_version": 1,
  "expected_herdr_protocol": 20,
  "commands": [
    {
      "id": "workspace.switch",
      "keys_action": "workspace_picker",
      "key": "prefix+w",
      "title": "Workspace: Switch…",
      "description": "Focus another workspace.",
      "command": ["workspace", "focus"],
      "arguments": [
        {
          "source": "select",
          "selector": "workspaces",
          "prompt": "workspace ▸ ",
          "exclude_context": "workspace_id"
        }
      ]
    },
    {
      "id": "workspace.next",
      "keys_action": "next_workspace",
      "title": "Workspace: Next",
      "description": "Focus the next workspace, wrapping after the last.",
      "command": ["workspace", "focus"],
      "arguments": [
        { "source": "context", "key": "next_workspace_id" }
      ]
    },
    {
      "id": "workspace.previous",
      "keys_action": "previous_workspace",
      "title": "Workspace: Previous",
      "description": "Focus the previous workspace, wrapping before the first.",
      "command": ["workspace", "focus"],
      "arguments": [
        { "source": "context", "key": "previous_workspace_id" }
      ]
    },
    {
      "id": "workspace.new",
      "keys_action": "new_workspace",
      "key": "prefix+shift+n",
      "title": "Workspace: New…",
      "description": "Create and focus a workspace in the selected directory.",
      "command": ["workspace", "create"],
      "arguments": [
        { "source": "literal", "value": "--cwd" },
        {
          "source": "input",
          "prompt": "workspace directory ▸ ",
          "description": "Enter an existing directory for the new workspace.",
          "required": true,
          "default_context": "cwd",
          "validation": "directory"
        },
        { "source": "literal", "value": "--focus" }
      ]
    },
    {
      "id": "workspace.rename",
      "keys_action": "rename_workspace",
      "key": "prefix+shift+w",
      "title": "Workspace: Rename current",
      "description": "Enter a new label for the workspace that opened the palette.",
      "command": ["workspace", "rename"],
      "arguments": [
        { "source": "context", "key": "workspace_id" },
        {
          "source": "input",
          "prompt": "new workspace label ▸ ",
          "description": "Enter a new label for the current workspace.",
          "required": true
        }
      ]
    },
    {
      "id": "workspace.close",
      "keys_action": "close_workspace",
      "key": "prefix+shift+d",
      "title": "Workspace: Close current",
      "description": "Close the workspace that opened the palette.",
      "command": ["workspace", "close"],
      "arguments": [
        { "source": "context", "key": "workspace_id" }
      ],
      "confirm": "Close the current workspace?"
    },
