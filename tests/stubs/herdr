#!/usr/bin/env bash
# herdr — a fake herdr CLI used only by tests/check-compat.bats, driven via
# HERDR_BIN_PATH. It reproduces the exact output shapes of the real herdr
# 0.8.0 CLI (`--version`, `api schema`, and `<group> <sub> -h` for every
# subcommand referenced by commands.json) so scripts/check-compat.sh can be
# exercised without a real herdr install. Text below was copied verbatim
# from real herdr 0.8.0 output, captured 2026-08-16.
#
# herdr's actual "-h" fallback behavior (measured against real herdr 0.8.0,
# 2026-08-16) has two distinct shapes, both reproduced below:
#   - an unrecognized subcommand within a KNOWN group (e.g. "pane teleport")
#     prints that group's own command list ("herdr pane commands: ...") and
#     exits 2.
#   - a wholly unrecognized group (e.g. "frobnicate teleport") falls back to
#     the top-level help and exits 0.
# scripts/check-compat.sh guards against both: a nonzero exit fails outright,
# and a zero exit is further required to contain a genuine
# "Usage: herdr <group> <sub>" line (which neither fallback shape prints).
#
# Env vars:
#   HERDR_STUB_PROTOCOL  — protocol number `api schema` reports (default 20)
#   HERDR_STUB_VERSION   — version string `--version` reports (default 0.8.0)
#   HERDR_STUB_CALLS     — optional file receiving runtime calls, one per line
#   HERDR_STUB_*_LIST_JSON — JSON returned by runtime workspace/tab/agent list calls
#   HERDR_STUB_LIST_STATUS — nonzero status for runtime list calls
#   HERDR_STUB_TAB_LIST_WITHOUT_WORKSPACE — omit --workspace from tab list help
#   HERDR_STUB_DEFAULT_CONFIG — overrides the `--default-config` template ("" = flag unsupported)
#   HERDR_STUB_PANE_OPEN_JSON / _STATUS / _ERROR — response of `plugin pane open`
set -uo pipefail

protocol="${HERDR_STUB_PROTOCOL:-20}"
version="${HERDR_STUB_VERSION:-0.8.0}"

record_call() {
  if [ -n "${HERDR_STUB_CALLS:-}" ]; then
    printf '%s\n' "$*" >>"$HERDR_STUB_CALLS"
  fi
}

