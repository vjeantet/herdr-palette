  [ -n "$agent_list_json" ] || agent_list_json='{"result":{"agents":[]}}'
  printf '%s\n' "$agent_list_json"
  exit 0
fi

if [ "${1:-} ${2:-}" = "tab list" ] && [ "${3:-}" = "--workspace" ] && [ "$#" -eq 4 ]; then
  record_call "$@"
  if [ "${HERDR_STUB_LIST_STATUS:-0}" -ne 0 ]; then
    printf '%s\n' "${HERDR_STUB_LIST_ERROR:-tab list error}" >&2
    exit "$HERDR_STUB_LIST_STATUS"
  fi
  tab_list_json="${HERDR_STUB_TAB_LIST_JSON:-}"
  [ -n "$tab_list_json" ] || tab_list_json='{"result":{"tabs":[]}}'
  printf '%s\n' "$tab_list_json"
  exit 0
fi

case "${1:-} ${2:-}" in
  "workspace focus"|"tab focus"|"agent focus"|"workspace create"|"workspace rename"|"workspace close"|"tab rename"|"tab close"|"pane rename"|"pane move"|"agent prompt"|"agent rename"|"worktree create"|"worktree open"|"worktree remove")
    if [ "${3:-}" != "-h" ]; then
      record_call "$@"
      printf '%s\n' '{"result":{}}'
      exit 0
    fi
    ;;
esac

# Plugin-action surface used by palette.bats. Same shape as the real herdr
# 0.8.0 CLI: one JSON line on stdout, and `plugin action invoke` returning as
# soon as the run is DISPATCHED (its outcome is read back from the log).
if [ "${1:-} ${2:-} ${3:-}" = "plugin action list" ] && [ "$#" -eq 3 ]; then
  # Deliberately NOT recorded: the palette queries this on every run, before
  # anything the caller asked for. Recording it would push every existing
  # ordering assertion ("the first call is tab list ...") off by one.
  if [ "${HERDR_STUB_ACTION_LIST_STATUS:-0}" -ne 0 ]; then
    printf '%s\n' "${HERDR_STUB_ACTION_LIST_ERROR:-plugin action list error}" >&2
    exit "$HERDR_STUB_ACTION_LIST_STATUS"
  fi
  action_list_json="${HERDR_STUB_ACTION_LIST_JSON:-}"
  [ -n "$action_list_json" ] || action_list_json='{"result":{"actions":[]}}'
  printf '%s\n' "$action_list_json"
  exit 0
fi

if [ "${1:-} ${2:-} ${3:-}" = "plugin action invoke" ] && [ "$#" -eq 4 ]; then
  record_call "$@"
  if [ "${HERDR_STUB_INVOKE_STATUS:-0}" -ne 0 ]; then
    printf '%s\n' "${HERDR_STUB_INVOKE_ERROR:-invoke error}" >&2
    exit "$HERDR_STUB_INVOKE_STATUS"
  fi
  invoke_json="${HERDR_STUB_INVOKE_JSON:-}"
  [ -n "$invoke_json" ] || invoke_json='{"result":{"log":{"log_id":"plugin-log-1","plugin_id":"stub.plugin","status":"running"}}}'
  printf '%s\n' "$invoke_json"
  exit 0
fi

if [ "${1:-} ${2:-} ${3:-}" = "plugin pane open" ]; then
  record_call "$@"
  if [ "${HERDR_STUB_PANE_OPEN_STATUS:-0}" -ne 0 ]; then
    printf '%s\n' "${HERDR_STUB_PANE_OPEN_ERROR:-plugin pane open error}" >&2
    exit "$HERDR_STUB_PANE_OPEN_STATUS"
  fi
  pane_open_json="${HERDR_STUB_PANE_OPEN_JSON:-}"
  [ -n "$pane_open_json" ] || pane_open_json='{"result":{"plugin_pane":{"plugin_id":"vjeantet.palette","entrypoint":"runner","pane":{"pane_id":"w1:p9"}}}}'
  printf '%s\n' "$pane_open_json"
  exit 0
fi

if [ "${1:-} ${2:-} ${3:-}" = "plugin log list" ]; then
  record_call "$@"
  log_json="${HERDR_STUB_PLUGIN_LOG_JSON:-}"
  [ -n "$log_json" ] || log_json='{"result":{"logs":[{"log_id":"plugin-log-1","plugin_id":"stub.plugin","status":"succeeded","exit_code":0}]}}'
  printf '%s\n' "$log_json"
  exit 0
fi

# `notification show`: how a detached plugin-action dispatch reports a
# failure, the popup being gone by then. Recorded with its full argv so a
# test can read the title and body back.
if [ "${1:-} ${2:-}" = "notification show" ]; then
  record_call "$@"
  printf '%s\n' '{"result":{}}'
