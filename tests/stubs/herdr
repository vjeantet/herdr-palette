EOF
    exit 0
    ;;
  "pane substr-flag-test")
    # Synthetic — not a real herdr subcommand. Exists only so
    # check-compat.bats can exercise the "a literal flag must exactly match
    # a declared option, not just appear as a substring of one" FAIL path
    # (e.g. commands.json says "--focus" but the subcommand only declares
    # "--focused"), which no real subcommand in this catalog happens to
    # trigger.
    cat <<'EOF'
Synthetic subcommand for check-compat.bats (not a real herdr subcommand)

Usage: herdr pane substr-flag-test [OPTIONS]

Options:
      --focused
EOF
    exit 0
    ;;
  "agent focus")
    cat <<'EOF'
Focus an agent

Usage: herdr agent focus <target>

Arguments:
  <target>
EOF
    exit 0
    ;;
  "agent list")
    cat <<'EOF'
List agents

Usage: herdr agent list
EOF
    exit 0
    ;;
  "server reload-config")
    cat <<'EOF'
Reload config in the running server

Usage: herdr server reload-config
EOF
    exit 0
    ;;
  *)
    group="${1:-}"
    if [ -n "$group" ] && is_known_group "$group"; then
      group_help "$group"
      exit 2
    fi
    top_level_help
    exit 0
    ;;
esac
