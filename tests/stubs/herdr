# is_known_group GROUP — true for exactly the groups this stub has real
# group_help() text for, i.e. the groups commands.json and this test suite
# reference. herdr itself recognizes more groups (api, config, channel,
# worktree, notification, session, integration, completion); they're not
# reproduced here because nothing in this repo exercises them.
is_known_group() {
  case "$1" in
    workspace|tab|pane|agent|server) return 0 ;;
    *) return 1 ;;
  esac
}

if [ "${1:-}" = "--version" ]; then
  echo "herdr $version"
  exit 0
fi

# Annotated config template, the shape `herdr --default-config` prints: the
# [keys] defaults appear as commented-out lines. Empty unless a test sets
# HERDR_STUB_DEFAULT_CONFIG — check-compat.sh treats "no output" as an older
# herdr and skips its default-keybinding check.
if [ "${1:-}" = "--default-config" ]; then
  # HERDR_STUB_DEFAULT_CONFIG set (even to "") overrides the captured
  # template below; an empty value models a herdr without the flag.
  if [ -n "${HERDR_STUB_DEFAULT_CONFIG+x}" ]; then
    if [ -n "$HERDR_STUB_DEFAULT_CONFIG" ]; then
      printf '%s\n' "$HERDR_STUB_DEFAULT_CONFIG"
    fi
    exit 0
