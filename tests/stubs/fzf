#!/usr/bin/env bash
# Most palette tests provide one command. Catalog-integration tests name the
# exact command to select so a missing or mistyped catalog ID is observable.
#
# FZF_STUB_DUMP, when set, appends every list this stub was handed to that
# file, so a test can assert on what the picker was actually offered.
#
# FZF_STUB_OPTS_DUMP, when set, appends the FZF_DEFAULT_OPTS this stub was
# handed, so a test can assert that the palette left the user's styling
# options alone.
#
# The stub also reacts to the two options whose damage the palette guards
# against, so those tests can observe the damage rather than merely assert on
# a variable:
#   --multi / -m    return a second row as well, as a user who tab-selected
#                   two candidates would
#   --print-query   print the query as an extra first line
# Options are read from FZF_DEFAULT_OPTS_FILE, then FZF_DEFAULT_OPTS, then the
# command line, which is real fzf's own precedence: a --no-multi passed by
# palette.sh therefore beats a --multi in the environment.
input=$(cat)

if [ -n "${FZF_STUB_DUMP:-}" ]; then
  printf '%s\n' "$input" >>"$FZF_STUB_DUMP"
fi
if [ -n "${FZF_STUB_OPTS_DUMP:-}" ]; then
  printf '%s\n' "${FZF_DEFAULT_OPTS:-}" >>"$FZF_STUB_OPTS_DUMP"
fi

opts_text=""
if [ -n "${FZF_DEFAULT_OPTS_FILE:-}" ] && [ -r "${FZF_DEFAULT_OPTS_FILE}" ]; then
  opts_text=$(cat "${FZF_DEFAULT_OPTS_FILE}")
fi
opts_text="$opts_text ${FZF_DEFAULT_OPTS:-}"

set -f
# shellcheck disable=SC2206  # deliberate: this is fzf's own tokenization
opt_words=($opts_text)
set +f
all_words=("${opt_words[@]}" "$@")

multi=0
print_query=0
query=""
for word in "${all_words[@]}"; do
  case "$word" in
    --multi|-m) multi=1 ;;
    --no-multi|+m) multi=0 ;;
    --print-query) print_query=1 ;;
    --no-print-query) print_query=0 ;;
    --query=*) query="${word#--query=}" ;;
  esac
done

if [ "$print_query" -eq 1 ]; then
  printf '%s\n' "$query"
fi

if [ -n "${FZF_STUB_SELECT_ID:-}" ]; then
  selection=$(printf '%s\n' "$input" \
    | awk -F '\t' -v id="$FZF_STUB_SELECT_ID" '$1 == id { print; exit }')
else
  selection=$(printf '%s\n' "$input" | sed -n '1p')
fi

# An empty selection is still printed as a blank line unless the query
# already stands in for it, which is what fzf does when nothing matched.
if [ -n "$selection" ] || [ "$print_query" -eq 0 ]; then
  printf '%s\n' "$selection"
fi

if [ "$multi" -eq 1 ]; then
  printf '%s\n' "$input" | grep -v -x -F -- "$selection" | sed -n '1p'
fi
